FROM python:3.12-slim AS base
WORKDIR /app
RUN pip install --no-cache-dir uv && \
    apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

FROM base AS development
COPY pyproject.toml uv.lock* ./
COPY services/api/pyproject.toml ./services/api/
RUN uv sync --frozen --no-install-project --package kos-api
COPY services/api ./services/api
ENV PYTHONPATH=/app/services/api
CMD [".venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

FROM base AS production
COPY pyproject.toml uv.lock* ./
COPY services/api/pyproject.toml ./services/api/
RUN uv sync --frozen --no-dev --no-install-project --package kos-api
COPY services/api ./services/api
ENV PYTHONPATH=/app/services/api
CMD [".venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
