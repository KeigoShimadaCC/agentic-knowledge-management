POSTGRES_DB=knowledgeos
POSTGRES_USER=kos
POSTGRES_PASSWORD=kospass

# Set this to the absolute path on your Mac where library files will be stored
LIBRARY_ROOT=/Users/YOUR_USERNAME/KnowledgeOS/library

# Optional: reserved for future CSRF / signed URLs (session cookies use DB-backed opaque tokens).
SESSION_SECRET=

# Closed appliance: set to false to disable POST /auth/register
ALLOW_OPEN_REGISTRATION=true

# When the API is served over HTTPS, set true so kos_session is marked Secure
COOKIE_SECURE=false

NEXT_PUBLIC_API_URL=http://localhost:8001
API_URL=http://api:8000

# Demo examples (optional): when SEED_DEMO_EXAMPLES=true the API seeds [Demo] pages at startup.
# docker-compose sets this for the api service; override locally if needed.
SEED_DEMO_EXAMPLES=false
# Use a domain email-validator accepts (.local is rejected). example.com is RFC 2606 documentation.
DEMO_SEED_EMAIL=demo@example.com
DEMO_SEED_PASSWORD=demo-demo-demo
DEMO_SEED_DISPLAY_NAME=Demo

# Active chat provider: 'openai' (default) or 'anthropic'. Pick the one whose key is set below.
# AI_PROVIDER=openai

# Add OpenAI key here before Phase 5. E2E uses sk-test-stub (API returns canned summaries, no network).
# OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=sk-test-stub

# Optional: use Anthropic Claude instead of OpenAI for chat. Set AI_PROVIDER=anthropic to activate.
# Embeddings always use OpenAI (Anthropic has no embeddings API); vector search degrades to BM25
# when only the Anthropic key is set. E2E uses sk-ant-test-stub for canned-summary mode.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-test-stub
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=2000

# Runtime Settings (Phase 16): generate a Fernet key to encrypt Settings-stored
# provider secrets. Docker mounts infra/.env at this fixed in-container path so
# Settings can export allowlisted runtime values for restart durability.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENV_FILE_PATH=/host/infra/.env

DEBUG=false

# ---------- MCP (Phase 7A) ----------
# Local-only stdio server for agent access (Claude Desktop, Cursor, Codex).
# Set MCP_ENABLED=true and generate a 32+ char random MCP_INTERNAL_TOKEN to activate.
# The API container and the kos-mcp process must share the same MCP_INTERNAL_TOKEN.
# Run: uv run --project services/mcp kos-mcp
MCP_ENABLED=false
# Host-side default: matches docker compose (127.0.0.1:8001 -> api:8000).
# If kos-mcp runs inside the docker network, set this to http://api:8000.
# If the API runs natively on port 8000, set this to http://127.0.0.1:8000.
MCP_API_BASE_URL=http://127.0.0.1:8001
MCP_INTERNAL_TOKEN=
# Scope MCP_INTERNAL_TOKEN to a specific user UUID. Strongly recommended once
# more than one user exists. Empty = legacy fallback resolves to the first user.
MCP_INTERNAL_USER_ID=

# Phase 7B: MCP write tools — disabled by default for safety
# Set MCP_ALLOW_WRITE_TOOLS=true to enable create_page, update_page, create_edge,
# archive_object, ingest_url, ingest_file tools.
MCP_ALLOW_WRITE_TOOLS=false

# Rate limits for MCP write tools (sliding window per agent identity)
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_RATE_LIMIT_PER_HOUR=600

# ---------- MCP Connections (Phase 12A + 12C) ----------
# Fernet symmetric key for encrypting external MCP API keys stored in mcp_connections.env_vars.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = MCP env var storage disabled (create returns 400 if env_vars are provided).
MCP_ENV_ENCRYPTION_KEY=

# Phase 12C: web-search MCP fallback for answer_from_kb.
# When use_web_search=true and the top KB score is below this threshold, a web-search MCP is called.
MCP_WEB_SEARCH_THRESHOLD=0.45
# Name of the MCP connection to prefer for web search. Empty = use first enabled connection with a matching tool.
MCP_WEB_SEARCH_CONNECTION_NAME=

# UX feature flags (PHASE-ENHANCE-03) — all default off (unset = off)
# Set to "1" to enable the cmdk-based search palette
# NEXT_PUBLIC_UX_SEARCH_V2=
# Set to "1" to enable editor bubble menu + slash menu
# NEXT_PUBLIC_UX_EDITOR_V2=

# ---------- Mobile / iPhone access (PHASE-PHONE-01B) ----------
# Reserved for future variants of infra/docker-compose.mobile.yml that bind the
# API to a specific host interface instead of 0.0.0.0 (e.g. a single LAN address).
# PHASE-PHONE-01B does not consume this variable; the current mobile override
# hard-codes the API binding to 0.0.0.0:8001. Leave commented out unless a
# follow-up phase wires it up.
# MOBILE_API_BIND_HOST=0.0.0.0
