POSTGRES_DB=knowledgeos
POSTGRES_USER=kos
POSTGRES_PASSWORD=kospass

# Set this to the absolute path on your Mac where library files will be stored
LIBRARY_ROOT=/Users/YOUR_USERNAME/KnowledgeOS/library

# Optional: reserved for future CSRF / signed URLs (session cookies use DB-backed opaque tokens).
SESSION_SECRET=

# Closed appliance: set to false to disable POST /auth/register
ALLOW_OPEN_REGISTRATION=true

# When the API is served over HTTPS, set true so kos_session is marked Secure
COOKIE_SECURE=false

NEXT_PUBLIC_API_URL=http://localhost:8001
API_URL=http://api:8000

# Demo examples (optional): when SEED_DEMO_EXAMPLES=true the API seeds [Demo] pages at startup.
# docker-compose sets this for the api service; override locally if needed.
SEED_DEMO_EXAMPLES=false
# Use a domain email-validator accepts (.local is rejected). example.com is RFC 2606 documentation.
DEMO_SEED_EMAIL=demo@example.com
DEMO_SEED_PASSWORD=demo-demo-demo
DEMO_SEED_DISPLAY_NAME=Demo

# Add OpenAI key here before Phase 5
# OPENAI_API_KEY=sk-...

DEBUG=false

# ---------- MCP (Phase 7A) ----------
# Local-only stdio server for agent access (Claude Desktop, Cursor, Codex).
# Set MCP_ENABLED=true and generate a 32+ char random MCP_INTERNAL_TOKEN to activate.
# The API container and the kos-mcp process must share the same MCP_INTERNAL_TOKEN.
# Run: uv run --project services/mcp kos-mcp
MCP_ENABLED=false
# Host-side default: matches docker compose (127.0.0.1:8001 -> api:8000).
# If kos-mcp runs inside the docker network, set this to http://api:8000.
# If the API runs natively on port 8000, set this to http://127.0.0.1:8000.
MCP_API_BASE_URL=http://127.0.0.1:8001
MCP_INTERNAL_TOKEN=
